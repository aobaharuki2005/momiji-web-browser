+
+bool momiji_legacy_outlines_enabled() {
+  return mozilla::StaticPrefs::
+             gfx_font_rendering_legacy_macos_outlines_AtStartup() &&
+         !nsCocoaFeatures::OnYosemiteOrLater();
+}
