-static void blinkRect(Rect* r) {
-  StRegionFromPool oldClip;
-  if (oldClip != NULL) ::GetClip(oldClip);
-
-  ::ClipRect(r);
-  ::InvertRect(r);
-  UInt32 end = ::TickCount() + 5;
-  while (::TickCount() < end);
-  ::InvertRect(r);
-
-  if (oldClip != NULL) ::SetClip(oldClip);
-}
